# Copy to .env (gitignored) and fill in real values before running
# `docker compose up`. See infrastructure/TEST_DEPLOYMENT.md.

# --- sck-api ---
SMTP_SERVER=
SMTP_PORT=465
SENDER_MAIL=
SENDER_PW=
# Not used by sck-api on master yet (lands with membership-registration).
# SEPA_ENCRYPTION_KEY=

# --- web build-time (see src/web/scripts/envsubst.sh) ---
# Full URL to the sck-api instance this web build should call.
SCK_API_URL=http://sck-api-test.example.com/api
COURSE_SHEET_URL=
TRIP_SHEET_URL=
