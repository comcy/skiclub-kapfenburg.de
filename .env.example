# Copy to .env (gitignored) and fill in real values before running
# `docker compose up`. See infrastructure/TEST_DEPLOYMENT.md.

# --- sck-api ---
SMTP_SERVER=
SMTP_PORT=465
SENDER_MAIL=
SENDER_PW=
# Required for the online membership registration form (field-level
# IBAN encryption) — a 32-byte hex string, e.g. `openssl rand -hex 32`.
SEPA_ENCRYPTION_KEY=
# Your own email — gets full admin-app access on first login, no invite
# needed. Blank means nobody can bootstrap into the admin app at all.
SUPER_ADMIN_EMAIL=
# Where the "admin" service (see docker-compose.yml) is actually reachable
# from your browser, e.g. http://<LXC-IP>:8081 — embedded in the
# magic-link login mail, so http://localhost:4200 (the default if unset)
# is useless here.
ADMIN_APP_URL=
# Where the "web" service (see docker-compose.yml) is actually reachable
# from your browser — embedded in the membership double-opt-in
# confirmation mail, http://localhost:4200 (the default if unset) is
# useless here just like ADMIN_APP_URL above.
SCK_APP_URL=
# Optional "Sign in with Google" for the admin app — magic-link works
# without these. From a Google Cloud OAuth client (Web application type):
# GOOGLE_CALLBACK_URL must exactly match the redirect URI registered there,
# and must be <SCK_API_URL below>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# Cloudflare Turnstile (Captcha) secret key, from the same widget as
# TURNSTILE_SITE_KEY below. Blank means the check on the public forms and
# admin login fails open (logs a warning, doesn't block anything) - see
# middleware/turnstile-middleware.ts.
TURNSTILE_SECRET_KEY=

# --- web build-time (see src/web/scripts/envsubst.sh) ---
# Full URL to the sck-api instance this web build should call.
SCK_API_URL=http://sck-api-test.example.com/api
COURSE_SHEET_URL=
TRIP_SHEET_URL=
# Cloudflare Turnstile site key (public, not a secret) - create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, "Managed" mode.
# Blank means the widget doesn't render and forms submit without a captcha
# check (matches TURNSTILE_SECRET_KEY above failing open).
TURNSTILE_SITE_KEY=
