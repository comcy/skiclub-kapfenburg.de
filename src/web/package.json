{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve sck-app",
    "build": "ng build sck-app",
    "build:admin": "ng build sck-admin-app",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --project sck-app --watch=false --browsers=ChromeHeadless",
    "test:admin": "ng test --project sck-admin-app --watch=false --browsers=ChromeHeadless",
    "test:trips-lib": "ng test --project trips-lib --watch=false --browsers=ChromeHeadless",
    "test:shared-lib": "ng test --project shared-lib --watch=false --browsers=ChromeHeadless",
    "test:courses-lib": "ng test --project courses-lib --watch=false --browsers=ChromeHeadless",
    "test:gym-lib": "ng test --project gym-lib --watch=false --browsers=ChromeHeadless",
    "test:membership-lib": "ng test --project membership-lib --watch=false --browsers=ChromeHeadless",
    "test:skilift-lib": "ng test --project skilift-lib --watch=false --browsers=ChromeHeadless",
    "test:coverage": "ng test --project sck-app --watch=false --browsers=ChromeHeadless --code-coverage",
    "prettier:check": "prettier --config .prettierrc --check \"projects/**/*.{ts,css,html}\"",
    "prettier:fix": "prettier --config .prettierrc --write \"projects/**/*.{ts,css,html}\"",
    "prepare": "cd ../.. && husky install src/web/.husky",
    "lint": "ng lint",
    "lint:admin": "ng lint sck-admin-app"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test"
    }
  },
  "lint-staged": {
    "projects/**/*.{ts,scss,html}": [
      "npm run prettier:fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/material": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "date-fns": "^4.1.0",
    "marked": "^15.0.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.1",
    "husky": "^8.0.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.2.10",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
